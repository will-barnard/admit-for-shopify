# Local development only. In production these are set as GLOBAL environment
# variables on the Beachhead dashboard (no Target Service) so that Docker
# Compose can substitute them as ${VAR} in docker-compose.yml. A var targeted at
# a single service is NOT written to .env and will resolve to an empty string.

# Postgres. Used by both the db and backend services in compose.
DB_PASSWORD=change-me

# Only needed when running the backend outside Docker; compose builds this from
# DB_PASSWORD.
DATABASE_URL=postgresql://postgres:change-me@db:5432/convention_tickets

PORT=3000
NODE_ENV=development

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Email delivery (Resend). Leave RESEND_API_KEY unset to disable sending -
# tickets are still created, just not emailed.
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Your Org <noreply@yourdomain.com>
ADMIN_EMAIL=admin@yourdomain.com

# Public base URL of the admin frontend. Baked into every QR code at ticket
# creation time as ${FRONTEND_URL}/verify/{uuid} - changing it later does NOT
# update QR codes that have already been issued.
FRONTEND_URL=http://localhost:8080

# Shared secret for the Shopify Flow HTTP actions (see SHOPIFY_API.md).
SHOPIFY_API_KEY=generate-a-long-random-string

# ---------------------------------------------------------------------------
# Shopify app (custom distribution). Leave unset to run without the Shopify
# integration - the app boots fine and the legacy Flow endpoints still work.
# Values come from the Dev Dashboard once the app record exists.
# ---------------------------------------------------------------------------
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=
SHOPIFY_APP_URL=https://your-app-domain
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_orders

# The shop that owns all pre-existing data. On a fresh install set this to the
# real myshopify.com domain so no backfill tenant is created.
DEFAULT_SHOP_DOMAIN=legacy.local
