# Repo-root .env - read by Docker Compose for ${VAR} substitution.
#
# ON BEACHHEAD YOU DO NOT COPY THIS FILE. Beachhead writes .env itself from the
# GLOBAL environment variables set on its dashboard (the ones with no Target
# Service). This file exists so you know which keys to create there, and so the
# stack can be run locally with `docker compose up`.
#
# A variable used as ${VAR} in docker-compose.yml MUST be global on the
# dashboard. A variable targeted at a single service is never written to .env
# and silently resolves to an empty string - a targeted DB_PASSWORD gives you a
# postgres container with a blank password.
#
# (backend/.env.example is a different thing: it is for running the backend
# directly on your machine, outside Docker.)

# --- Database -------------------------------------------------------------
DB_PASSWORD=change-me

# --- Auth -----------------------------------------------------------------
# Long random string. Generate a fresh one per instance:
#   openssl rand -base64 48
JWT_SECRET=change-me

# --- Email (Resend) -------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Your Org <tickets@yourdomain.com>
ADMIN_EMAIL=you@yourdomain.com

# --- Public URL -----------------------------------------------------------
# Baked into every QR code at ticket creation time as ${FRONTEND_URL}/verify/{uuid}.
# It is NOT resolved at scan time, so changing it later does not fix QR codes
# that have already been issued. Set it correctly before creating any ticket.
FRONTEND_URL=https://tickets.yourdomain.com

# --- Legacy Shopify Flow integration --------------------------------------
# Shared secret for the Flow "Send HTTP request" actions (see SHOPIFY_API.md).
# Superseded by the real app below; keep it until Flow is switched off.
SHOPIFY_API_KEY=change-me

# --- Shopify app (custom distribution) ------------------------------------
# From the Dev Dashboard: Apps -> your app -> Client credentials.
# Leave CLIENT_ID and CLIENT_SECRET empty to keep the integration dormant -
# the app boots fine and the legacy Flow endpoints keep working.
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=

# Must match application_url in shopify.app.toml.
SHOPIFY_APP_URL=https://tickets.yourdomain.com

# Keep in step with [webhooks] api_version in shopify.app.toml.
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_orders

# The shop that owns all data created before the Shopify app was connected.
# On a brand new install, set this to your real myshopify.com domain so no
# placeholder tenant is ever created.
DEFAULT_SHOP_DOMAIN=your-store.myshopify.com

# --- Tuning (all optional; the defaults are what production runs) ----------
# How many proxies sit in front of the backend. Deployed that is Beachhead's
# nginx-proxy and then the app's own nginx, so 2. Express uses it to pick the
# real client address out of X-Forwarded-For, which is what the login rate
# limiter keys on. Set 0 if you run the backend with nothing in front of it.
#TRUST_PROXY_HOPS=2

# Delay between messages in a bulk email job. Sending happens in a background
# worker now, so this only paces Resend - it no longer holds a request open.
#BULK_EMAIL_INTERVAL_MS=6000

# Successful sends allowed per shop per day, across ticket emails and bulk.
#EMAIL_DAILY_LIMIT=100
